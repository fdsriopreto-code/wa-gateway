# ---- HTTP ----
HTTP_ADDR=:3000
PUBLIC_URL=http://localhost:3000

# ---- PostgreSQL (obrigatorio) ----
# usado pela aplicacao E pelo sqlstore do whatsmeow
DATABASE_URL=postgres://wa:wa@localhost:5432/wa?sslmode=disable

# ---- Redis (obrigatorio) ----
REDIS_URL=redis://localhost:6379/0

# pool de conexoes do Postgres (0 = auto: no minimo 10)
DATABASE_MAX_CONNS=0

# ---- Auth ----
# chave-mestra de bootstrap; concede escopo "*". deixe vazia para exigir chaves da tabela api_keys
API_KEY=change-me-please

# ---- Engine ----
DEFAULT_ENGINE=whatsmeow

# ---- Webhook ----
WEBHOOK_TIMEOUT=15s
WEBHOOK_MAX_ATTEMPTS=15

# ---- Fila de saida (pacing anti-ban) ----
# aplicado quando o envio e feito com "enqueue": true. Sobrescrevivel por
# sessao em config.outbox (minIntervalMs / jitterMs / dailyLimit).
OUTBOX_MIN_INTERVAL=3s
OUTBOX_JITTER=2s
OUTBOX_DAILY_LIMIT=0

# ---- Persistencia de mensagens/chats (historico + download de midia antiga) ----
# on (padrao) | off
MESSAGE_STORE=on

# ---- Mídia ----
# apaga a mídia guardada (S3/MinIO) N tempo depois de recebida. 0 = guarda
# pra sempre. Sobrescrevível por sessão em config.media.ttl. Ex.: 168h = 7d.
MEDIA_TTL=0
# de quanto em quanto tempo o coletor varre as mídias vencidas
MEDIA_GC_INTERVAL=5m

# ---- Armazenamento de midia (opcional) ----
# none (padrao) | s3  -- s3 serve tambem MinIO / Cloudflare R2
MEDIA_BACKEND=none
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wa-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
S3_PATH_STYLE=true
# se setado, /api/media/{id}?redirect=true aponta pra ca em vez de gerar URL assinada
S3_PUBLIC_BASE_URL=

# ---- HTTP extras ----
# origens permitidas p/ CORS (CSV). vazio = só same-origin. "*" libera geral
# (a API ainda exige X-Api-Key). Útil se hospedar o console noutro domínio.
CORS_ORIGINS=
# loga uma linha por request (method, path, status, duração)
ACCESS_LOG=false
# rate limit por chave de API (token bucket no Redis). 0 desliga.
# a chave-mestra (API_KEY) fica isenta. burst 0 = 2x RPS (mín 10).
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=0

# ---- Segurança ----
# 64 caracteres hex (32 bytes). Liga a cifra AES-256-GCM dos secrets de
# webhook em repouso (sessions.config + webhook_deliveries.payload no
# Postgres). Vazio = texto puro. Gere com: openssl rand -hex 32
SECRET_KEY=
# rotação sem downtime: chaves antigas (CSV) que ainda DECIFRAM valores
# gravados antes da troca. Novos valores sempre usam SECRET_KEY.
SECRET_KEY_OLD=

# ---- Multi-nó ----
NODE_ID=
# URL HTTP deste nó alcançável pelos OUTROS nós. Setar liga o roteamento de
# request entre nós (request que chega no nó errado é encaminhado pro dono da
# sessão). Deixe vazio se roda 1 réplica só.
NODE_ADVERTISE_URL=

# ---- Observabilidade ----
LOG_LEVEL=info
LOG_FORMAT=text
